# Copy to .env (which is gitignored) and fill in — never commit real values.
# Used by scripts/run_bolt_backend.py (CognoDB / Neo4j / Memgraph):
BOLT_URI=bolt+s://<instance-id>.databases.cognodb.cloud
BOLT_USER=cognodb
BOLT_PASSWORD=

# Used by scripts/run_arango_backend.py:
ARANGO_URL=http://localhost:8529
ARANGO_PASSWORD=
